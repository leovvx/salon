# Copy this file to .env and adjust if needed (optional).

# Ollama server address.
#  - Ollama on the same machine:        http://localhost:11434
#  - Ollama on a Windows PC on the LAN: http://192.168.1.42:11434  (use the PC's IP)
OLLAMA_HOST=http://localhost:11434

# Default model for the agents (can be changed later in the UI settings).
OLLAMA_MODEL=qwen3:4b

# Web UI port.
PORT=8765
