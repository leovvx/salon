# Copie ce fichier en .env et adapte si besoin (facultatif).

# Adresse du serveur Ollama.
#  - Ollama sur la même machine :      http://localhost:11434
#  - Ollama sur un PC Windows du LAN : http://192.168.1.42:11434  (mets l'IP du PC)
OLLAMA_HOST=http://localhost:11434

# Modèle par défaut des agents (modifiable ensuite dans les réglages de l'interface).
OLLAMA_MODEL=qwen3:4b

# Port de l'interface web.
PORT=8765
